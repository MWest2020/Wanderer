{{define "reporting.tmpl"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wanderer — reporting</title>
<link rel="stylesheet" href="/ui/static/main.css">
</head>
<body>
{{template "nav.tmpl" dict "Active" "reporting" "HasReporting" .HasReporting "OrgSlug" .OrgSlug}}
<header>
  <h1>Reporting · rule catalogue</h1>
  <p class="meta">
    Every metric Wanderer measures, with the dimension it informs
    and the rationale that explains why it matters. Click a row
    to see how each target scores on the rule.
    · Generated {{.GeneratedAt}}
  </p>
</header>
<main>
{{if .Rows}}
<table class="rule-catalogue">
  <thead>
    <tr>
      <th>Framework</th>
      <th>Dimension</th>
      <th>Rule</th>
      <th>What it measures</th>
    </tr>
  </thead>
  <tbody>
    {{range .Rows}}
    <tr>
      <td><code>{{.Framework}}</code></td>
      <td><code>{{.Dimension}}</code></td>
      <td><a href="/ui/reporting/{{.Framework}}/{{.CriteriumID}}"><code>{{.CriteriumID}}</code></a></td>
      <td>
        <strong>{{.Description}}</strong>
        {{if .Rationale}}<details class="why"><summary class="muted small">why this matters</summary><p class="rationale-text">{{.Rationale}}</p></details>{{end}}
      </td>
    </tr>
    {{end}}
  </tbody>
</table>
{{else}}
<p class="empty-state">No rules registered.</p>
{{end}}
</main>
</body>
</html>
{{end}}
