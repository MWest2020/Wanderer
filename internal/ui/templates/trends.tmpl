{{define "trends.tmpl"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wanderer — trends</title>
<link rel="stylesheet" href="/ui/static/main.css">
</head>
<body>
{{template "nav.tmpl" dict "Active" "trends" "HasReporting" .HasReporting "OrgSlug" .OrgSlug}}
<header>
  <h1>Trends · rules across your fleet</h1>
  <p class="meta">
    Every metric Wanderer measures, how it currently scores across your
    targets, and the per-rule breakdown. Click a rule for the
    per-target deep dive.
    · Generated {{.GeneratedAt}}
    {{if .ScopedOrganisation}}
    · <span class="scope-pill">Scope: <a href="{{.ScopedOrganisation.URL}}">{{.ScopedOrganisation.Name}}</a></span>
    · <a href="/ui/trends">show all organisations →</a>
    {{else}}
    · <span class="muted">all organisations</span>
    {{end}}
  </p>
  <dl class="headline-stats">
    <div>
      <dt>Last scan</dt>
      <dd>{{if .Headline.LastScanAt}}<code>{{.Headline.LastScanAt}}</code>{{else}}<span class="muted">no scans yet</span>{{end}}</dd>
    </div>
    <div>
      <dt>Scans</dt>
      <dd>{{.Headline.TotalScans}}</dd>
    </div>
    <div>
      <dt>External coverage</dt>
      <dd>{{.Headline.PerimeterTargets}} perimeter target{{if ne .Headline.PerimeterTargets 1}}s{{end}}</dd>
    </div>
    <div>
      <dt>Internal coverage</dt>
      <dd>{{if eq .Headline.AgentHostTargets 0}}<span class="muted">no agent hosts reporting</span>{{else}}{{.Headline.AgentHostTargets}} agent host{{if ne .Headline.AgentHostTargets 1}}s{{end}}{{end}}</dd>
    </div>
    <div>
      <dt>Frameworks scored</dt>
      <dd>{{if .Headline.Frameworks}}{{range $i, $fw := .Headline.Frameworks}}{{if $i}}, {{end}}<code>{{$fw}}</code>{{end}}{{else}}<span class="muted">none yet</span>{{end}}</dd>
    </div>
  </dl>
</header>
<main>

{{if .Targets}}
<section class="dashboard-section targets-fleet">
  <h2>Targets <span class="scope-label">your fleet, last scan &amp; verdict</span></h2>
  <table class="targets">
    <thead>
      <tr><th>Target</th><th>Verdict</th><th>Last scan</th><th></th></tr>
    </thead>
    <tbody>
      {{range .Targets}}
      <tr>
        <td>
          {{if .ReportURL}}<a href="{{.ReportURL}}">{{.Domain}}</a>{{else}}{{.Domain}}{{end}}
          {{if eq .Kind "host"}}<span class="badge kind-host">host</span>{{end}}
        </td>
        <td>
          {{if .Verdict}}<span class="badge score-{{.Verdict}}">{{.Verdict}}</span>{{if .VerdictDimensions}} <span class="meta covers">covers: {{.VerdictDimensions}}</span>{{end}}{{else}}<span class="muted">not assessed</span>{{end}}
          {{if .AccountabilityLink}}<a class="badge pill-accountability-{{.AccountabilityClass}}" href="{{.AccountabilityLink}}" title="accountability">verantwoording: {{.AccountabilityLabel}}</a>{{else}}<span class="badge pill-accountability-{{.AccountabilityClass}}" title="accountability">verantwoording: {{.AccountabilityLabel}}</span>{{end}}
        </td>
        <td>{{if .LastScanAt}}<code>{{.LastScanAt}}</code> <span class="status-{{.LastStatus}}">{{.LastStatus}}</span>{{else}}<span class="muted">never</span>{{end}}</td>
        <td>{{if .ReportURL}}<a href="{{.ReportURL}}">report →</a>{{end}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
</section>
{{end}}

<section class="dashboard-section">
  <h2>Verdict <span class="scope-label">is this OK?</span></h2>
  {{if .Verdicts}}
  <div class="verdict-grid">
    {{range .Verdicts}}
    <div class="verdict-block">
      <div class="verdict-framework"><code>{{.Framework}}</code></div>
      <span class="badge verdict-pill score-{{.Score}}">{{.Score}}</span>
      <p class="meta">
        {{if eq .Score "soeverein"}}
        all {{.Total}} target{{if ne .Total 1}}s{{end}} sovereign — no action needed.
        {{else if eq .Score "onbekend"}}
        {{.Total}} target{{if ne .Total 1}}s{{end}} assessed but no clear signal yet — likely a missing probe (GeoLite2, IP, etc.).
        {{else}}
        worst-case score reached on {{.AtWorst}} of {{.Total}} target{{if ne .Total 1}}s{{end}}.
        {{end}}
      </p>
    </div>
    {{end}}
  </div>
  {{else}}
  <p class="muted">No assessments yet. Run <code>wanderer assess &lt;scan-id&gt; --framework both</code>.</p>
  {{end}}
</section>

{{if .FlowRollup}}
<section class="dashboard-section sovereignty-rollup">
  <h2>Sovereignty by flow <span class="scope-label">what goes where</span></h2>
  <table class="flows">
    <tbody>
    {{range .FlowRollup}}
      <tr>
        <th scope="row">{{.Label}}</th>
        <td><span class="badge score-{{.Worst}}">{{.Worst}}</span></td>
        <td>
          {{if gt .Afhankelijk 0}}{{.Afhankelijk}} of {{.Total}} outside EEA{{else}}all {{.Total}} in EEA{{end}}
        </td>
      </tr>
    {{end}}
    </tbody>
  </table>
</section>
{{end}}

{{if .OrganisationsList}}
<section class="dashboard-section">
  <h2>Organisations</h2>
  <table class="organisations">
    <thead>
      <tr><th>Slug</th><th>Name</th><th class="num">Targets</th></tr>
    </thead>
    <tbody>
      {{range .OrganisationsList}}
      <tr>
        <td><a href="{{.URL}}"><code>{{.Slug}}</code></a></td>
        <td>{{.Name}}</td>
        <td class="num">{{.TargetCount}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
</section>
{{end}}

<section class="dashboard-section">
  <h2>Rule catalogue <span class="scope-label">what we measure &amp; how it scores</span></h2>
  {{if .Catalogue}}
  <table class="rule-catalogue">
    <thead>
      <tr>
        <th>Framework</th>
        <th>Dimension</th>
        <th>Rule</th>
        <th>What it measures</th>
        <th>Current state</th>
      </tr>
    </thead>
    <tbody>
      {{range .Catalogue}}
      <tr>
        <td><code>{{.Framework}}</code></td>
        <td><code>{{.Dimension}}</code></td>
        <td><a href="/ui/reporting/{{.Framework}}/{{.CriteriumID}}{{if $.OrgSlug}}?org={{$.OrgSlug}}{{end}}"><code>{{.CriteriumID}}</code></a></td>
        <td>
          <strong>{{.Description}}</strong>
          {{if .Rationale}}<details class="why"><summary class="muted small">why this matters</summary><p class="rationale-text">{{.Rationale}}</p></details>{{end}}
        </td>
        <td>
          {{if .Status}}
          <span class="badge score-{{.Status}}">{{.Status}}</span>
          <div class="muted small">{{.AtWorst}} of {{.Total}} target{{if ne .Total 1}}s{{end}}</div>
          {{else}}
          <span class="muted">no rationale yet</span>
          {{end}}
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty-state">No rules registered.</p>
  {{end}}
</section>

<section class="dashboard-section">
  <h2>Score matrix <span class="scope-label">per-rule, across targets</span></h2>
  {{if .Matrix}}
  <table class="reporting-rules">
    <thead>
      <tr>
        <th>Framework</th>
        <th>Rule</th>
        <th class="num">soeverein</th>
        <th class="num">voldoende</th>
        <th class="num">afhankelijk</th>
        <th class="num">onbekend</th>
      </tr>
    </thead>
    <tbody>
      {{range .Matrix}}
      <tr>
        <td>{{.Framework}}</td>
        <td>
          <a href="/ui/reporting/{{.Framework}}/{{.CriteriumID}}{{if $.OrgSlug}}?org={{$.OrgSlug}}{{end}}"><code>{{.CriteriumID}}</code></a>
          {{if .Description}}<div class="muted small">{{.Description}}</div>{{end}}
        </td>
        <td class="num">{{if .SoevereinCount}}<span class="badge score-soeverein">{{.SoevereinCount}}</span>{{else}}<span class="muted">—</span>{{end}}</td>
        <td class="num">{{if .VoldoendeCount}}<span class="badge score-voldoende">{{.VoldoendeCount}}</span>{{else}}<span class="muted">—</span>{{end}}</td>
        <td class="num">{{if .AfhankelijkCount}}<span class="badge score-afhankelijk">{{.AfhankelijkCount}}</span>{{else}}<span class="muted">—</span>{{end}}</td>
        <td class="num">{{if .OnbekendCount}}<span class="badge score-onbekend">{{.OnbekendCount}}</span>{{else}}<span class="muted">—</span>{{end}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty-state">
    No rules have produced rationales yet. Run
    <code>wanderer assess &lt;scan-id&gt; --framework both</code> after at least one
    <code>wanderer scan &lt;domain&gt;</code>.
  </p>
  {{end}}
</section>

</main>
</body>
</html>
{{end}}
