{{define "dashboard.tmpl"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wanderer — dashboard</title>
<link rel="stylesheet" href="/ui/static/main.css">
</head>
<body>
{{template "nav.tmpl" dict "Active" "dashboard" "HasReporting" .HasReporting}}
<header class="headline">
  <h1>Wanderer · sovereignty observation</h1>
  <p class="meta">Generated {{.GeneratedAt}}</p>
  <dl class="headline-stats">
    <div>
      <dt>Last scan</dt>
      <dd>{{if .Headline.LastScanAt}}<code>{{.Headline.LastScanAt}}</code>{{else}}<span class="muted">no scans yet</span>{{end}}</dd>
    </div>
    <div>
      <dt>Scans</dt>
      <dd>{{.Headline.TotalScans}}</dd>
    </div>
    <div>
      <dt>External coverage</dt>
      <dd>{{.Headline.PerimeterTargets}} perimeter target{{if ne .Headline.PerimeterTargets 1}}s{{end}}</dd>
    </div>
    <div>
      <dt>Internal coverage</dt>
      <dd>{{if eq .Headline.AgentHostTargets 0}}<span class="muted">no agent hosts reporting</span>{{else}}{{.Headline.AgentHostTargets}} agent host{{if ne .Headline.AgentHostTargets 1}}s{{end}}{{end}}</dd>
    </div>
    <div>
      <dt>Frameworks scored</dt>
      <dd>{{if .Headline.Frameworks}}{{range $i, $fw := .Headline.Frameworks}}{{if $i}}, {{end}}<code>{{$fw}}</code>{{end}}{{else}}<span class="muted">none yet</span>{{end}}</dd>
    </div>
  </dl>
</header>
<main>
{{if not .HasData}}
<p class="empty-state">
  No scans yet. Run <code>wanderer scan &lt;domain&gt;</code> against a
  target to populate the store; the dashboard refreshes on every
  page load.
</p>
{{else}}

<section class="dashboard-section">
  <h2>External posture <span class="scope-label">perimeter scans</span></h2>
  {{if .ExternalPostureBlocks}}
  <div class="posture-grid">
    {{range .ExternalPostureBlocks}}
    <div class="posture-block">
      <h3>{{.Framework}}</h3>
      <ul class="posture-counts">
        {{range .Counts}}
        <li><span class="badge score-{{.Score}}">{{.Count}} {{.Score}}</span></li>
        {{end}}
      </ul>
      <p class="meta">{{.Total}} target{{if ne .Total 1}}s{{end}} assessed</p>
    </div>
    {{end}}
  </div>
  {{else}}
  <p class="muted">
    No perimeter Assessments yet. Run
    <code>wanderer assess &lt;scan-id&gt; --framework both</code> after a
    <code>wanderer scan &lt;domain&gt;</code>.
  </p>
  {{end}}
</section>

<section class="dashboard-section">
  <h2>Internal posture <span class="scope-label">agent host inspectors</span></h2>
  {{if .InternalPostureBlocks}}
  <div class="posture-grid">
    {{range .InternalPostureBlocks}}
    <div class="posture-block">
      <h3>{{.Framework}}</h3>
      <ul class="posture-counts">
        {{range .Counts}}
        <li><span class="badge score-{{.Score}}">{{.Count}} {{.Score}}</span></li>
        {{end}}
      </ul>
      <p class="meta">{{.Total}} host{{if ne .Total 1}}s{{end}} assessed</p>
    </div>
    {{end}}
  </div>
  {{else}}
  <p class="muted">
    No agent hosts reporting yet. Run
    <code>wanderer agent --config &lt;path&gt;</code> on a host to onboard
    one; the agent's inventory and egress inspectors land Findings
    in the same store and surface here.
  </p>
  {{end}}
</section>

<section class="dashboard-section">
  <h2>Top concerns</h2>
  {{if .TopConcerns}}
  <table class="concerns">
    <thead>
      <tr>
        <th>Framework</th>
        <th>Rule</th>
        <th>Targets</th>
      </tr>
    </thead>
    <tbody>
      {{range .TopConcerns}}
      <tr>
        <td>{{.Framework}}</td>
        <td>
          <code>{{.CriteriumID}}</code>
          {{if .Description}}
          <details class="why">
            <summary>{{.Description}}</summary>
            {{if .Rationale}}<p class="rationale-text">{{.Rationale}}</p>{{end}}
          </details>
          {{end}}
        </td>
        <td><span class="badge score-afhankelijk">{{.TargetCount}}</span></td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="muted">No `afhankelijk` rationales recorded yet.</p>
  {{end}}
</section>

<section class="dashboard-section">
  <h2>Recent activity</h2>
  {{if .Activity}}
  <table>
    <thead>
      <tr>
        <th>When</th>
        <th>Domain</th>
        <th>Status</th>
        <th>Open</th>
      </tr>
    </thead>
    <tbody>
      {{range .Activity}}
      <tr>
        <td><code>{{.StartedAt}}</code></td>
        <td>{{.Domain}}</td>
        <td><span class="status-{{.Status}}">{{.Status}}</span></td>
        <td>
          {{if .HasAssessment}}
          <a href="/ui/scans/{{.ScanID}}/assessment">assessment →</a>
          {{else}}
          <a href="/ui/scans/{{.ScanID}}">findings →</a>
          {{end}}
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="muted">No scans yet.</p>
  {{end}}
</section>

{{end}}
</main>
</body>
</html>
{{end}}
