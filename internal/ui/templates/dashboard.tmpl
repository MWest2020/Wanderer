{{define "dashboard.tmpl"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wanderer — antwoord</title>
<link rel="stylesheet" href="/ui/static/main.css">
</head>
<body>
{{template "nav.tmpl" dict "Active" "dashboard" "HasReporting" .HasReporting "OrgSlug" .OrgSlug}}
<header class="door-header">
  {{if .ScopedOrganisation}}
  <h1>{{.ScopedOrganisation.Name}}</h1>
  <p class="meta">Generated {{.GeneratedAt}} · <a href="/ui/">← all organisations</a></p>
  {{else}}
  <h1>Wanderer</h1>
  <p class="meta">Generated {{.GeneratedAt}}</p>
  {{end}}
</header>
<main>

{{if .AllowScan}}
<form class="scan-form door-form" method="post" action="/ui/scan">
  <label for="scan-domain">Domein of host</label>
  <input id="scan-domain" name="domain" type="text" list="agent-hosts" placeholder="voorbeeld.nl of jouw-host" required autofocus>
  {{if .AgentHosts}}
  <datalist id="agent-hosts">
    {{range .AgentHosts}}<option value="{{.}}">{{end}}
  </datalist>
  {{end}}
  <button type="submit">Scan</button>
  <span class="meta">start een scan en land direct op het antwoord</span>
</form>
{{end}}

{{if .Recent}}
<section class="dashboard-section door-recent">
  <h2>Recent beantwoord</h2>
  <ul class="answer-lines">
    {{range .Recent}}
    <li class="answer-line">
      <a href="{{.ReportURL}}">{{.Domain}}</a>{{if eq .Kind "host"}} <span class="badge kind-host">host</span>{{end}}
      <span class="badge answer-badge-{{.Verdict}}">{{.Verdict}}</span>
      <span class="answer-line-text">{{.Headline}}</span>
      <span class="meta">{{.LastScanAt}}</span>
    </li>
    {{end}}
  </ul>
</section>
{{else}}
<p class="empty-state">
  No scans yet. Run <code>wanderer scan &lt;domain&gt;</code> against a
  target{{if .AllowScan}}, or use the form above,{{end}} to get an answer.
</p>
{{end}}

</main>
</body>
</html>
{{end}}
