{{define "nav.tmpl"}}
{{- $q := "" -}}
{{- if .OrgSlug -}}{{- $q = printf "?org=%s" .OrgSlug -}}{{- end -}}
{{- $dashHref := "/ui/" -}}
{{- if .OrgSlug -}}{{- $dashHref = printf "/ui/orgs/%s" .OrgSlug -}}{{- end -}}
<nav class="nav-bar">
  <a class="nav-link {{if eq .Active "dashboard"}}is-active{{end}}" href="{{$dashHref}}">Overview</a>
  {{if .HasReporting}}<a class="nav-link {{if eq .Active "trends"}}is-active{{end}}" href="/ui/trends{{$q}}">Trends</a>{{end}}
</nav>
{{end}}
