{{/* answer-rows renders a []AccountabilityAnswer as the answer-sheet
     rows accountability pioneered (design.md "UI direction") — one
     plain-language question per row, ja/nee/onbekend/n.v.t., the
     observed fact in the verdict, evidence (rule ID, protocol jargon)
     collapsed beneath. Shared by the sovereignty-flows section and the
     accountability dimension so the reasoning page has exactly one
     rendering of this pattern (run 04 task 4.1: "bouw geen tweede
     weergave"). */}}
{{define "answer-rows"}}
{{range .}}
<article class="answer-row answer-{{.AnswerClass}}">
  <p class="answer-question">{{.Question}}</p>
  <p class="answer-verdict">
    <span class="badge answer-badge-{{.AnswerClass}}">{{.AnswerLabel}}</span>
    {{.Verdict}}
  </p>
  {{if .Remediation}}
  <p class="answer-remediation">→ {{.Remediation}}</p>
  {{end}}
  <details class="answer-evidence">
    <summary>bewijs</summary>
    <p><code>{{.RuleID}}</code>{{if .RuleDescription}} — {{.RuleDescription}}{{end}}</p>
    {{if .Evidence}}
    {{range .Evidence}}
    <p><code>{{.ProbeID}}</code> op <code>{{.Subject}}</code></p>
    <ul>
      {{range .Attributes}}<li><code>{{.Key}}</code>: {{.Value}}</li>{{end}}
    </ul>
    {{end}}
    {{else}}
    <p class="muted">Geen bewijs beschikbaar{{if .NoEvidenceNote}} — {{.NoEvidenceNote}}{{end}}.</p>
    {{end}}
  </details>
</article>
{{end}}
{{end}}
{{define "assessment.tmpl"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wanderer — {{.Domain}}</title>
<link rel="stylesheet" href="/ui/static/main.css">
</head>
<body>
{{template "nav.tmpl" dict "Active" "" "HasReporting" .HasReporting "OrgSlug" .OrgSlug}}
<header>
  <h1>{{.Domain}}</h1>
  <p class="meta">
    Scan started {{.StartedAt}}
    · Status <span class="status-{{.Status}}">{{.Status}}</span>
    · Scan <code>{{.ScanID}}</code>
  </p>
  <p>
    <a href="{{.AnswerURL}}">← antwoord</a>
    · <a href="/ui/">dashboard</a>
    · <a href="/ui/targets">all targets</a>
    · <a href="/ui/scans/{{.ScanID}}">Findings (raw) →</a>
  </p>
</header>
<main>
{{if .FlowAnswers}}
<section class="sovereignty-overview">
  <h2>Onderbouwing — soevereiniteit</h2>
  <p class="meta">Waar deze dienst draait en waar het verkeer doorheen gaat — per stroom een vraag met antwoord, bewijs ingeklapt eronder.</p>
  <div class="sov-layout">
  <div class="flows answer-sheet">
  {{template "answer-rows" .FlowAnswers}}
  </div>
  {{if .Diagram.Nodes}}
  {{with .Diagram}}
  <svg class="sov-diagram" viewBox="0 0 {{.Width}} {{.Height}}" width="{{.Width}}" height="{{.Height}}" role="img" aria-label="Sovereignty flow diagram — the host at the centre, each flow a spoke coloured by score">
    {{$cx := .CenterX}}{{$cy := .CenterY}}
    {{range .Nodes}}<line x1="{{$cx}}" y1="{{$cy}}" x2="{{.X}}" y2="{{.Y}}"></line>
    {{end}}
    {{range .Nodes}}<circle class="node score-{{.Score}}" cx="{{.X}}" cy="{{.Y}}" r="9"></circle>
    <text x="{{.LabelX}}" y="{{.LabelY}}" text-anchor="{{.Anchor}}">{{.Label}}</text>
    {{end}}
    <circle class="hub" cx="{{.CenterX}}" cy="{{.CenterY}}" r="36"></circle>
    <text class="hub-label" x="{{.CenterX}}" y="{{.CenterY}}" dy="4">{{.Subject}}</text>
  </svg>
  {{end}}
  {{end}}
  </div>
</section>
{{end}}
{{if .Frameworks}}
<div class="frameworks">
{{range .Frameworks}}
<section class="framework">
  <h2>{{.Framework}}</h2>
  <p class="meta">Generated {{.CreatedAt}}</p>
  {{if .Accountability}}
  {{$fw := .Framework}}
  {{with .Accountability}}
  <article class="dimension-card answer-sheet" id="{{$fw}}-accountability">
    <header class="dimension-header">
      <h3>accountability</h3>
      <span class="badge score-{{.Score}}">{{.Score}}</span>
      <span class="completeness">completeness: {{.Completeness}}</span>
    </header>
    {{range .ScannerWarnings}}
    <p class="scanner-warning">⚠ {{.}}</p>
    {{end}}
    {{if .Answers}}
    {{template "answer-rows" .Answers}}
    {{else}}
    <p class="muted">No rationales for this dimension.</p>
    {{end}}
  </article>
  {{end}}
  {{end}}
  {{range .Dimensions}}
  <article class="dimension-card">
    <header class="dimension-header">
      <h3>{{.Dimension}}</h3>
      <span class="badge score-{{.Score}}">{{.Score}}</span>
      <span class="completeness">completeness: {{.Completeness}}</span>
    </header>
    {{range .ScannerWarnings}}
    <p class="scanner-warning">⚠ {{.}}</p>
    {{end}}
    {{if .Rationales}}
    <table class="rationales">
      <thead>
        <tr>
          <th>Criterium</th>
          <th>Score</th>
          <th>Verdict</th>
          <th>Evidence</th>
        </tr>
      </thead>
      <tbody>
        {{range .Rationales}}
        <tr class="score-row-{{.Score}}{{if .Retired}} retired{{end}}">
          <td>
            <code>{{.CriteriumID}}</code>
            <details class="why">
              <summary>{{.Description}}</summary>
              <p class="rationale-text">{{.Rationale}}</p>
            </details>
          </td>
          <td><span class="badge score-{{.Score}}">{{.Score}}</span></td>
          <td>{{.Verdict}}</td>
          <td class="evidence">
            {{range .Evidence}}
            <a href="/ui/scans/{{$.ScanID}}#{{.}}"><code>{{.}}</code></a>
            {{else}}<span class="muted">—</span>{{end}}
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
    {{else}}
    <p class="muted">No rationales for this dimension.</p>
    {{end}}
  </article>
  {{end}}
</section>
{{end}}
</div>
{{else}}
<p class="empty-state">
  No assessment has been produced for this scan yet.<br>
  Run <code>wanderer assess {{.ScanID}} --framework both</code>
  to score this scan against the DICTU and EU CSF (SEAL) rule packs.
</p>
{{end}}
</main>
</body>
</html>
{{end}}
