{{define "reporting_rule.tmpl"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wanderer — {{.CriteriumID}}</title>
<link rel="stylesheet" href="/ui/static/main.css">
</head>
<body>
{{template "nav.tmpl" dict "Active" "trends" "HasReporting" .HasReporting "OrgSlug" .OrgSlug}}
<header>
  <p class="meta">
    {{if .OrgSlug}}<a href="/ui/reporting?org={{.OrgSlug}}">← reporting index</a>{{else}}<a href="/ui/reporting">← reporting index</a>{{end}}
  </p>
  <h1><code>{{.CriteriumID}}</code></h1>
  <p class="meta">
    Framework <code>{{.Framework}}</code>
    · Dimension <code>{{.Dimension}}</code>
    · Generated {{.GeneratedAt}}
    {{if .ScopedOrganisation}}
    · <span class="scope-pill">Scope: <a href="{{.ScopedOrganisation.URL}}">{{.ScopedOrganisation.Name}}</a></span>
    {{end}}
  </p>
  {{if .Description}}<p class="rule-description">{{.Description}}</p>{{end}}
  {{if .Rationale}}<p class="rationale-text">{{.Rationale}}</p>{{end}}
  {{if .Observation}}<p class="rule-observation"><strong>Waarneming:</strong> {{.Observation}}</p>{{end}}
  {{if .Thresholds}}
  <div class="rule-thresholds">
    <strong>Grenzen:</strong>
    <ul>
      {{range .Thresholds}}<li>{{.Explanation}} ({{.Name}}: {{.Value}} {{.Unit}})</li>{{end}}
    </ul>
  </div>
  {{else}}
  <p class="rule-thresholds muted">Deze regel kijkt of iets aanwezig is — er is geen numerieke grens.</p>
  {{end}}
</header>
<main>
{{if .Rows}}
<table>
  <thead>
    <tr>
      <th>Target</th>
      <th>Score</th>
      <th>Verdict</th>
      <th>When</th>
    </tr>
  </thead>
  <tbody>
    {{range .Rows}}
    <tr>
      <td>
        <a href="/ui/scans/{{.ScanID}}/assessment">{{.Domain}}</a>
      </td>
      <td><span class="badge score-{{.Score}}">{{.Score}}</span></td>
      <td>
        {{linkify .Verdict}}
        {{if .Remediation}}<p class="answer-remediation">→ {{.Remediation}}</p>{{end}}
      </td>
      <td><code>{{.When}}</code></td>
    </tr>
    {{end}}
  </tbody>
</table>
{{else}}
<p class="empty-state">
  This rule has not produced any rationale rows on the persisted
  Assessments. Re-run <code>wanderer assess</code> against a fresh
  scan if you expect coverage.
</p>
{{end}}
</main>
</body>
</html>
{{end}}
