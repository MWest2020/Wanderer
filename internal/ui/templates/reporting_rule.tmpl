{{define "reporting_rule.tmpl"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wanderer — {{.CriteriumID}}</title>
<link rel="stylesheet" href="/ui/static/main.css">
</head>
<body>
{{template "nav.tmpl" dict "Active" "reporting" "HasReporting" .HasReporting}}
<header>
  <p class="meta"><a href="/ui/reporting">← reporting index</a></p>
  <h1><code>{{.CriteriumID}}</code></h1>
  <p class="meta">
    Framework <code>{{.Framework}}</code>
    · Dimension <code>{{.Dimension}}</code>
    · Generated {{.GeneratedAt}}
  </p>
  {{if .Description}}<p class="rule-description">{{.Description}}</p>{{end}}
  {{if .Rationale}}<p class="rationale-text">{{.Rationale}}</p>{{end}}
</header>
<main>
{{if .Rows}}
<table>
  <thead>
    <tr>
      <th>Target</th>
      <th>Score</th>
      <th>Verdict</th>
      <th>When</th>
    </tr>
  </thead>
  <tbody>
    {{range .Rows}}
    <tr>
      <td>
        <a href="/ui/scans/{{.ScanID}}/assessment">{{.Domain}}</a>
      </td>
      <td><span class="badge score-{{.Score}}">{{.Score}}</span></td>
      <td>{{.Verdict}}</td>
      <td><code>{{.When}}</code></td>
    </tr>
    {{end}}
  </tbody>
</table>
{{else}}
<p class="empty-state">
  This rule has not produced any rationale rows on the persisted
  Assessments. Re-run <code>wanderer assess</code> against a fresh
  scan if you expect coverage.
</p>
{{end}}
</main>
</body>
</html>
{{end}}
