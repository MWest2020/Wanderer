{{define "scan-status.tmpl"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wanderer — scanning {{.Domain}}</title>
<link rel="stylesheet" href="/ui/static/main.css">
<meta http-equiv="refresh" content="3">
</head>
<body>
{{template "nav.tmpl" dict "Active" "" "HasReporting" .HasReporting "OrgSlug" ""}}
<header>
  <h1>{{.Domain}}</h1>
</header>
<main>
  <div class="scan-progress">
    <span class="spinner" aria-hidden="true"></span>
    <div>
      <p><strong>Bezig met starten…</strong> de scan is nog niet begonnen.</p>
    </div>
  </div>
  <p class="meta">Deze pagina ververst automatisch en opent het antwoord zodra de scan begint. <a href="/ui/scan-status?domain={{.Domain}}">nu verversen</a> · <a href="/ui/">dashboard</a></p>
</main>
</body>
</html>{{end}}
