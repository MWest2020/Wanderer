# eBPF build intermediates. vmlinux.h is regenerated by
# scripts/bpf-build.sh from the host's /sys/kernel/btf/vmlinux —
# kernel-version specific, ~5 MB, not worth committing. The
# bpf2go-generated _bpfel_*.go and _bpfel_*.o files ARE committed
# (so `go build` works without the clang toolchain).
internal/probe/egress/flow/bpf/vmlinux.h

# Playwright. node_modules and the runtime report dir are local
# scratch; the spec sources, package.json, and package-lock.json
# DO ship. Curated screenshots for docs live under
# docs/screenshots/ (separate, manually committed).
tests/playwright/node_modules/
tests/playwright/playwright-report/
tests/playwright/test-results/
